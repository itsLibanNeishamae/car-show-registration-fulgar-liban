### POST test: reject a duplicate plate number using the successful Competitor registration.
POST {{baseUrl}}/api/registrations
Content-Type: application/json

{
  "participantName": "Duplicate Plate {{testRunId}}",
  "contactNumber": "09171234576",
  "email": "duplicate-{{testRunId}}@example.com",
  "address": "6 Mabini Street, Manila",
  "carMakeModel": "Toyota Supra MK4",
  "plateNumber": "{{competitorPlate}}",
  "registrationType": "Competitor",
  "amountPaid": 0
}

> {% 
client.test("duplicate plate returns a Registration.Conflict ProblemDetails response", function () {
    client.assert(response.status === 409);
    client.assert(response.body.title === "Registration.Conflict");
    client.assert(response.body.detail.includes(client.global.get("competitorPlate")));
});
%}

### GET test: default pagination uses page 1 and page size 10.
GET {{baseUrl}}/api/registrations

> {% 
client.test("default pagination metadata is correct", function () {
    client.assert(response.status === 200);
    client.assert(response.body.page === 1);
    client.assert(response.body.pageSize === 10);
    client.assert(response.body.items.length <= 10);
});
client.global.set("listTotalCount", response.body.totalCount);
%}

### GET test: newest registrations are ordered first.
GET {{baseUrl}}/api/registrations?pageSize=50

> {% 
client.test("registration dates are sorted newest first", function () {
    client.assert(response.status === 200);
    const dates = response.body.items.map(item => Date.parse(item.registrationDate));
    client.assert(dates.every((date, index) => index === 0 || dates[index - 1] >= date));
});
%}

