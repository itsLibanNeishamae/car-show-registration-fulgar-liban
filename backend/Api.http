### POST test: ignore client-supplied registration number, date, fee, status, and payment status.
POST {{baseUrl}}/api/registrations
Content-Type: application/json

{
  "participantName": "Managed Fields Test {{testRunId}}",
  "contactNumber": "09171234570",
  "email": "managed-{{testRunId}}@example.com",
  "address": "45 Rizal Street, Naga City",
  "carMakeModel": "Mazda RX-7 FD",
  "plateNumber": "TST-{{testRunId}}-D",
  "registrationType": "Exhibitor",
  "amountPaid": 0,
  "registrationNumber": "CLIENT-CONTROLLED",
  "registrationDate": "2000-01-01T00:00:00Z",
  "registrationFee": 0,
  "status": "Cancelled",
  "paymentStatus": "Paid"
}

> {% 
client.test("server-managed fields are ignored", function () {
    client.assert(response.status === 201);
    client.assert(response.body.registrationNumber !== "CLIENT-CONTROLLED");
    client.assert(response.body.registrationNumber.match(/^CS27-\d{4,}$/));
    client.assert(response.body.registrationFee === 1500);
    client.assert(response.body.status === "Pending");
    client.assert(response.body.paymentStatus === "Unpaid");
});
client.global.set("managedFieldsId", response.body.id);
%}

### POST test: reject empty required fields with a validation ProblemDetails response.
POST {{baseUrl}}/api/registrations
Content-Type: application/json

{
  "participantName": "",
  "contactNumber": "",
  "email": "",
  "address": "",
  "carMakeModel": "",
  "plateNumber": "",
  "registrationType": "Competitor",
  "amountPaid": 0
}

> {% 
client.test("empty required fields return validation errors", function () {
    client.assert(response.status === 400);
    client.assert(response.body.status === 400);
    client.assert(response.body.errors.ParticipantName.length > 0);
});
%}

