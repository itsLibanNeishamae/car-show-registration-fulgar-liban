### SUMMARY test: all KPI fields are present and status counts add up to total registrations.
GET {{baseUrl}}/api/registrations/summary

> {% 
client.test("summary contains all KPI fields and consistent status counts", function () {
    client.assert(response.status === 200);
    ["totalRegistrations", "confirmed", "checkedIn", "pending", "cancelled", "totalFees", "totalPayments", "uncollectedPayments"]
        .forEach(field => client.assert(Object.prototype.hasOwnProperty.call(response.body, field)));
    client.assert(response.body.confirmed + response.body.checkedIn + response.body.pending + response.body.cancelled === response.body.totalRegistrations);
    client.assert(response.body.totalRegistrations === Number(client.global.get("listTotalCount")));
});
client.global.set("summaryAfterCreate", response.body.totalRegistrations);
%}

### SUMMARY test: uncollected payments equal fees minus payments.
GET {{baseUrl}}/api/registrations/summary

> {% 
client.test("summary financial formula is correct", function () {
    client.assert(response.status === 200);
    client.assert(Math.abs(response.body.uncollectedPayments - (response.body.totalFees - response.body.totalPayments)) < 0.001);
});
%}

### SUMMARY test: financial totals exclude Cancelled registrations.
GET {{baseUrl}}/api/registrations?pageSize=50

> {% 
client.test("summary fees and payments exclude cancelled entries", function () {
    client.assert(response.status === 200);
    const active = response.body.items.filter(item => item.status !== "Cancelled");
    const fees = active.reduce((total, item) => total + item.registrationFee, 0);
    const payments = active.reduce((total, item) => total + item.amountPaid, 0);
    client.assert(response.body.totalCount <= 50);
    client.global.set("activeFeesFromList", fees);
    client.global.set("activePaymentsFromList", payments);
});
%}

### SUMMARY test: summary count increases by one after a successful creation.
GET {{baseUrl}}/api/registrations/summary

> {% 
client.test("summary reflects the successful registration created in this run", function () {
    client.assert(response.status === 200);
    client.assert(response.body.totalRegistrations === Number(client.global.get("summaryBeforeCreate")) + 4);
});
%}

### DATABASE persistence test: restart the API, then request this saved registration; it should still exist.
GET {{baseUrl}}/api/registrations/{{competitorId}}

> {% 
client.test("registration persists after API restart", function () {
    client.assert(response.status === 200);
    client.assert(response.body.id === client.global.get("competitorId"));
});
%}

### DATABASE uniqueness test: all listed registration numbers follow CS27-XXXX and are unique.
GET {{baseUrl}}/api/registrations?pageSize=50

> {% 
client.test("registration numbers are formatted and unique", function () {
    const numbers = response.body.items.map(item => item.registrationNumber);
    client.assert(response.status === 200);
    client.assert(numbers.every(number => /^CS27-\d{4,}$/.test(number)));
    client.assert(new Set(numbers).size === numbers.length);
});
%}

### DATABASE index check: run the SQLite command below and confirm unique indexes exist on PlateNumber and RegistrationNumber.
# From the repository root:
# sqlite3 backend/Api/Data/carshow.db "PRAGMA index_list('Registrations');"
# Then inspect each unique index with: sqlite3 backend/Api/Data/carshow.db "PRAGMA index_info('IX_Registrations_PlateNumber');"
# and: sqlite3 backend/Api/Data/carshow.db "PRAGMA index_info('IX_Registrations_RegistrationNumber');"
