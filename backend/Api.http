@baseUrl = http://localhost:5000

### Test fixture: capture the current summary total before creating a test registration.
GET {{baseUrl}}/api/registrations/summary

> {% 
client.test("baseline summary is available", function () {
    client.assert(response.status === 200);
});
client.global.set("summaryBeforeCreate", response.body.totalRegistrations);
client.global.set("testRunId", Date.now().toString().slice(-7));
%}

### POST test: create a Competitor registration and verify fee, payment state, server-generated number, and UTC date.
POST {{baseUrl}}/api/registrations
Content-Type: application/json

{
  "participantName": "HTTP Competitor {{testRunId}}",
  "contactNumber": "09171234567",
  "email": "competitor-{{testRunId}}@example.com",
  "address": "12 Ayala Avenue, Makati City",
  "carMakeModel": "Toyota Supra MK4",
  "plateNumber": "TST-{{testRunId}}-A",
  "registrationType": "Competitor",
  "amountPaid": 1000.00
}

> {% 
client.test("Competitor registration is created with server values", function () {
    client.assert(response.status === 201);
    client.assert(response.body.registrationNumber.match(/^CS27-\d{4,}$/));
    client.assert(response.body.registrationFee === 2500);
    client.assert(response.body.status === "Pending");
    client.assert(response.body.paymentStatus === "Partial");
    client.assert(response.body.registrationDate.endsWith("Z"));
});
client.global.set("competitorId", response.body.id);
client.global.set("competitorPlate", response.body.plateNumber);
client.global.set("competitorRegistrationNumber", response.body.registrationNumber);
%}

### POST test: create an Exhibitor registration with no payment and verify the Unpaid state.
POST {{baseUrl}}/api/registrations
Content-Type: application/json

{
  "participantName": "HTTP Exhibitor {{testRunId}}",
  "contactNumber": "09171234568",
  "email": "exhibitor-{{testRunId}}@example.com",
  "address": "88 Session Road, Baguio City",
  "carMakeModel": "Honda Civic Type R",
  "plateNumber": "TST-{{testRunId}}-B",
  "registrationType": "Exhibitor",
  "amountPaid": 0
}

> {% 
client.test("Exhibitor registration has the correct fee and unpaid status", function () {
    client.assert(response.status === 201);
    client.assert(response.body.registrationFee === 1500);
    client.assert(response.body.paymentStatus === "Unpaid");
});
%}

